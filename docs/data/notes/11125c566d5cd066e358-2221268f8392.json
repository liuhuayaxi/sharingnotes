"end":1931.6,"corrected":true,"cipher":""},{"id":"32","start":1931.6,"end":1991.0,"corrected":true,"cipher":""},{"id":"33","start":1991.0,"end":2051.1,"corrected":true,"cipher":""},{"id":"34","start":2051.1,"end":2102.9,"corrected":true,"cipher":""},{"id":"35","start":2102.9,"end":2155.0,"corrected":true,"cipher":""},{"id":"36","start":2155.0,"end":2205.2,"corrected":true,"cipher":""},{"id":"37","start":2205.2,"end":2272.3,"corrected":true,"cipher":""},{"id":"38","start":2272.3,"end":2339.5,"corrected":true,"cipher":""},{"id":"39","start":2339.5,"end":2398.8,"corrected":true,"cipher":""},{"id":"40","start":2398.8,"end":2465.0,"corrected":true,"cipher":""},{"id":"41","start":2465.0,"end":2525.9,"corrected":true,"cipher":""},{"id":"42","start":2525.9,"end":2577.6,"corrected":true,"cipher":"QE7p7uKZyD4lsbBCrd7rctI2E9aMVTgsBiee1q8Uu2RoPi+JZIbh9gThs29TH1/qdrvwJsIf7L6JcV3vrDCUvS86bH09xkm18yZqY1FLFZVATetlMrIjm0URItWqOQ=="},{"id":"43","start":2577.6,"end":2628.7,"corrected":true,"cipher":"r1+Sx2rFJZW/VRAUm45CUr2oZCbBGHDEHEg1L6R53gMqdGB1Q64O/SVyoBQAVJKAoMmuRDJwWUyQbWvKrRCbUsfTXKsOz8N3sudLQxYujbocznwGq4dLDEBMFfE1tKun5IVsGQt57HY6"},{"id":"44","start":2628.7,"end":2692.9,"corrected":true,"cipher":""},{"id":"45","start":2692.9,"end":2746.1,"corrected":true,"cipher":""},{"id":"46","start":2746.1,"end":2817.259,"corrected":true,"cipher":""}],"reviewStatus":"skipped","version":"2221268f839224a6f55232a89686ebc042ca928281ad9eb07df7b0a663b59128","wordCount":11767,"images":[{"src":"data/images/a8be6bc160457c68abdce8e1fe837b45b6f112f5d5b77e8daf29c70c0e986903.png","sha256":"a8be6bc160457c68abdce8e1fe837b45b6f112f5d5b77e8daf29c70c0e986903","width":1536,"height":864},{"src":"data/images/d07c8d7d741129c4ed40ef79b72bfe6aca97273fea7b1b57e7bc3f65a378b88f.png","sha256":"d07c8d7d741129c4ed40ef79b72bfe6aca97273fea7b1b57e7bc3f65a378b88f","width":1536,"height":864},{"src":"data/images/c2672d2fcdf5331ca03221fb09fc3ad36356df42207a7e3482e612c5582db9db.png","sha256":"c2672d2fcdf5331ca03221fb09fc3ad36356df42207a7e3482e612c5582db9db","width":1536,"height":864},{"src":"data/images/e75b7123b8868a99c763cbd3204786c1d23ecd26e6f1114a29b72b06ecb784a2.png","sha256":"e75b7123b8868a99c763cbd3204786c1d23ecd26e6f1114a29b72b06ecb784a2","width":1536,"height":864},{"src":"data/images/1202aed6e9e035c5281b67a4064c08f4d7b149aef87f1007d4d14fa4dc460517.png","sha256":"1202aed6e9e035c5281b67a4064c08f4d7b149aef87f1007d4d14fa4dc460517","width":1536,"height":864},{"src":"data/images/015c5483bf6b2206cf932adb8734d0dcb0e51df088969b97db184cd585468c5f.png","sha256":"015c5483bf6b2206cf932adb8734d0dcb0e51df088969b97db184cd585468c5f","width":1536,"height":864},{"src":"data/images/9fea5a6976f31dcdf6c0d1ea37baf95ea191509677bbeba9990fcbbf1788c586.png","sha256":"9fea5a6976f31dcdf6c0d1ea37baf95ea191509677bbeba9990fcbbf1788c586","width":1536,"height":864},{"src":"data/images/eafa3318ab738e4b7084e3600858a87b6f581e9375f3b70fc87c8e869f116edc.png","sha256":"eafa3318ab738e4b7084e3600858a87b6f581e9375f3b70fc87c8e869f116edc","width":1536,"height":864},{"src":"data/images/6500b67a2de83f9dc2d4e058362bed9697538c508b3463573ed0939b4455a00e.png","sha256":"6500b67a2de83f9dc2d4e058362bed9697538c508b3463573ed0939b4455a00e","width":1536,"height":864},{"src":"data/images/238f15eff08839ee3a583f396efb79ed8c817f7416cd53d881708d3da3358d52.png","sha256":"238f15eff08839ee3a583f396efb79ed8c817f7416cd53d881708d3da3358d52","width":1536,"height":864},{"src":"data/images/ad3e88823b688f5f7e9cffcd6ffe3d976eff6f00658db8908d8b5d48bb922b61.png","sha256":"ad3e88823b688f5f7e9cffcd6ffe3d976eff6f00658db8908d8b5d48bb922b61","width":1536,"height":864}],"imageCount":11}